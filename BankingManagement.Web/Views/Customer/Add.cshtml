@model CreateCustomerModel

@{
    ViewData["Title"] = "Add Customer";
}

<div class="customer-form-wrapper">

    <!-- Page Header -->
    <div class="page-header">

        <a asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left"></i>
            Back to Customers
        </a>

        <div class="header-content">

            <div class="header-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>

            <div>
                <h1>Add Customer</h1>
                <p>Register a new customer account in the banking system</p>
            </div>

        </div>

    </div>

    <!-- Main Card -->
    <div class="customer-main-card">

        <form asp-action="Add" method="post">

            <div class="section">

                <div class="section-heading">
                    <div class="section-icon">
                        <i class="bi bi-person-vcard"></i>
                    </div>
                    <div>
                        <h3>Customer Information</h3>
                        <p>Fill in the required personal and contact details</p>
                    </div>
                </div>

                <!-- API / Model Error Summary -->
                <div asp-validation-summary="ModelOnly" class="form-error"></div>

                <div class="form-grid">

                    <!-- Full Name -->
                    <div class="form-field">
                        <label asp-for="Name">
                            Customer Full Name <span>*</span>
                        </label>
                        <div class="input-container">
                            <i class="bi bi-person"></i>
                            <input asp-for="Name" placeholder="Enter customer's full name" />
                        </div>
                        <span asp-validation-for="Name" class="validation-message"></span>
                    </div>

                    <!-- Email -->
                    <div class="form-field">
                        <label asp-for="Email">
                            Email Address <span>*</span>
                        </label>
                        <div class="input-container">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="Email" type="email" placeholder="example@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="validation-message"></span>
                    </div>

                    <!-- Phone -->
                    <div class="form-field">
                        <label asp-for="Phone">
                            Phone Number <span>*</span>
                        </label>
                        <div class="input-container">
                            <i class="bi bi-telephone"></i>
                            <input asp-for="Phone" type="tel" maxlength="10" placeholder="10-digit phone number" />
                        </div>
                        <span asp-validation-for="Phone" class="validation-message"></span>
                    </div>

                    <!-- Address -->
                    <div class="form-field full-width">
                        <label asp-for="Address">
                            Residential Address <span>*</span>
                        </label>
                        <div class="input-container textarea-container">
                            <i class="bi bi-geo-alt"></i>
                            <textarea asp-for="Address" rows="3" placeholder="Enter customer residential address"></textarea>
                        </div>
                        <span asp-validation-for="Address" class="validation-message"></span>
                    </div>

                </div>

            </div>

            <!-- Footer -->
            <div class="form-footer">

                <a asp-action="Index" class="cancel-button">
                    Cancel
                </a>

                <button type="submit" class="submit-button">
                    <i class="bi bi-person-plus-fill"></i>
                    Create Customer
                </button>

            </div>

        </form>

    </div>

</div>

<style>

    body {
        background: #f5f7fb;
    }

    .customer-form-wrapper {
        max-width: 900px;
        margin: 30px auto;
        padding: 0 20px 40px;
    }

    /* =========================
           HEADER
           ========================= */

    .page-header {
        margin-bottom: 25px;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 20px;
        transition: .2s;
    }

        .back-button:hover {
            color: #2563eb;
        }

    .header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 25px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 8px 20px rgba(37, 99, 235, .25);
    }

    .header-content h1 {
        margin: 0;
        font-size: 27px;
        font-weight: 750;
        color: #1e293b;
    }

    .header-content p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    /* =========================
           MAIN CARD
           ========================= */

    .customer-main-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        box-shadow: 0 10px 35px rgba(15, 23, 42, .07);
        overflow: hidden;
    }

    .section {
        padding: 30px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 25px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        background: #eef4ff;
        color: #2563eb;
    }

    .section-heading h3 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #1e293b;
    }

    .section-heading p {
        margin: 3px 0 0;
        color: #64748b;
        font-size: 12px;
    }

    /* =========================
           FORM
           ========================= */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .full-width {
        grid-column: span 2;
    }

    .form-field label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: 13px;
        font-weight: 650;
    }

        .form-field label span {
            color: #dc2626;
        }

    .input-container {
        position: relative;
        display: flex;
        align-items: center;
        border: 1px solid #dbe1ea;
        border-radius: 11px;
        background: #fff;
        transition: .2s;
    }

        .input-container i {
            position: absolute;
            left: 14px;
            color: #94a3b8;
            font-size: 16px;
        }

        .input-container input {
            width: 100%;
            height: 48px;
            border: none;
            outline: none;
            padding: 0 14px 0 44px;
            font-size: 14px;
            color: #1e293b;
            border-radius: 11px;
            background: transparent;
        }

        .input-container:focus-within {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
        }

    .textarea-container {
        align-items: flex-start;
    }

        .textarea-container i {
            top: 14px;
        }

        .textarea-container textarea {
            width: 100%;
            border: none;
            outline: none;
            padding: 12px 14px 12px 44px;
            font-size: 14px;
            color: #1e293b;
            border-radius: 11px;
            background: transparent;
            resize: vertical;
        }

    .validation-message {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 12px;
    }

    .form-error {
        margin-bottom: 18px;
        color: #dc2626;
        font-size: 13px;
    }

    /* =========================
           FOOTER
           ========================= */

    .form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 20px 30px;
        background: #fafbfe;
        border-top: 1px solid #eef2f7;
    }

    .cancel-button,
    .submit-button {
        height: 44px;
        padding: 0 22px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        transition: .2s;
        cursor: pointer;
    }

    .cancel-button {
        background: #f1f5f9;
        color: #475569;
    }

        .cancel-button:hover {
            background: #e2e8f0;
            color: #334155;
        }

    .submit-button {
        border: none;
        color: white;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 5px 15px rgba(37, 99, 235, .25);
    }

        .submit-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(37, 99, 235, .32);
        }

    /* =========================
           MOBILE
           ========================= */

    @@media (max-width: 768px) {
        .customer-form-wrapper {
            padding: 0 12px;
            margin-top: 20px;
        }

        .section {
            padding: 20px 16px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: span 1;
        }

        .form-footer {
            padding: 16px;
            flex-direction: column-reverse;
        }

        .cancel-button,
        .submit-button {
            width: 100%;
        }
    }

</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
