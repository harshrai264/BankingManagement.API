@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">

    <!-- Welcome Header -->
    <div class="dashboard-header">
        <div>
            <span class="welcome-text">Welcome back 👋</span>
            <h1>Banking Management</h1>
            <p>Manage customers, accounts and banking operations from one place.</p>
        </div>
        <div class="date-box">
            <span><i class="bi bi-calendar-event"></i></span>
            @DateTime.Now.ToString("dd MMM yyyy")
        </div>
    </div>

    <!-- Main Modules -->
    <div class="module-grid">

        <!-- Customers -->
        <div class="module-card">
            <div class="module-icon customers-icon">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="module-content">
                <span class="module-label">Customers</span>
                <h3>Manage Customers</h3>
                <p>View and manage all customers.</p>
                <a asp-controller="Customer" asp-action="Index" class="module-link">
                    View Customers <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- Accounts -->
        <div class="module-card">
            <div class="module-icon accounts-icon">
                <i class="bi bi-bank2"></i>
            </div>
            <div class="module-content">
                <span class="module-label">Accounts</span>
                <h3>Manage Accounts</h3>
                <p>Create, view and manage customer bank accounts.</p>
                <a asp-controller="Account" asp-action="Index" class="primary-btn">
                    <i class="bi bi-arrow-right"></i> Manage Accounts
                </a>
            </div>
        </div>

        <!-- Transactions -->
        <div class="module-card disabled-card">
            <div class="module-icon transactions-icon">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <div class="module-content">
                <span class="module-label">Transactions</span>
                <h3>Monitor Transactions</h3>
                <p>Monitor and manage banking transactions.</p>
                <span class="coming-soon">Coming Soon</span>
            </div>
        </div>

        <!-- Payments -->
        <div class="module-card disabled-card">
            <div class="module-icon payments-icon">
                <i class="bi bi-credit-card-fill"></i>
            </div>
            <div class="module-content">
                <span class="module-label">Payments</span>
                <h3>Manage Payments</h3>
                <p>Manage customer payment operations.</p>
                <span class="coming-soon">Coming Soon</span>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <div class="quick-header">
            <div>
                <h2>Quick Actions</h2>
                <p>Frequently used banking operations</p>
            </div>
            <i class="bi bi-lightning-charge-fill quick-icon"></i>
        </div>

        <div class="quick-grid">
            <!-- View Customers -->
            <a asp-controller="Customer" asp-action="Index" class="quick-card">
                <div class="quick-card-icon blue">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="quick-card-content">
                    <h4>Customers</h4>
                    <span>View and manage customers</span>
                </div>
                <i class="bi bi-chevron-right arrow-icon"></i>
            </a>

            <!-- Add Customer -->
            <a asp-controller="Customer" asp-action="Add" class="quick-card">
                <div class="quick-card-icon green">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <div class="quick-card-content">
                    <h4>Add Customer</h4>
                    <span>Create a new customer</span>
                </div>
                <i class="bi bi-chevron-right arrow-icon"></i>
            </a>

            <!-- Accounts -->
            <a asp-controller="Account" asp-action="Index" class="quick-card">
                <div class="quick-card-icon orange">
                    <i class="bi bi-bank"></i>
                </div>
                <div class="quick-card-content">
                    <h4>Accounts</h4>
                    <span>Manage bank accounts</span>
                </div>
                <i class="bi bi-chevron-right arrow-icon"></i>
            </a>

            <!-- Transactions -->
            <div class="quick-card disabled-quick-card">
                <div class="quick-card-icon purple">
                    <i class="bi bi-arrow-left-right"></i>
                </div>
                <div class="quick-card-content">
                    <h4>Transactions</h4>
                    <span>View transactions</span>
                </div>
                <span class="soon-badge">Soon</span>
            </div>
        </div>
    </div>

</div>