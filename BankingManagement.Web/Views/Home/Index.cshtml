@model BankingManagement.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    body {
        background: #f5f7fb;
        color: #172b4d;
    }

    .dashboard-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 35px 25px 50px;
    }

    /* =========================
           HEADER
           ========================= */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 35px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .bank-logo {
        width: 62px;
        height: 62px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        font-size: 29px;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.22);
    }

    .welcome-text {
        font-size: 14px;
        color: #7b8794;
        margin-bottom: 3px;
    }

    .dashboard-title {
        font-size: 29px;
        font-weight: 700;
        margin: 0;
        color: #172b4d;
    }

    .dashboard-subtitle {
        margin: 5px 0 0;
        color: #7b8794;
        font-size: 14px;
    }

    .header-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .date-box {
        background: white;
        border: 1px solid #e6eaf0;
        padding: 11px 16px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 14px;
        color: #52606d;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
    }

        .date-box i {
            color: #2563eb;
            font-size: 16px;
        }

    .signout-btn {
        text-decoration: none;
        background: white;
        border: 1px solid #e6eaf0;
        color: #52606d;
        padding: 11px 16px;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }

        .signout-btn:hover {
            background: #fff5f5;
            color: #dc3545;
            border-color: #f1caca;
        }


    /* =========================
           STATISTICS
           ========================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 38px;
    }

    .stat-card {
        background: white;
        border: 1px solid #e8edf3;
        border-radius: 18px;
        padding: 23px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
        }

    .stat-label {
        color: #7b8794;
        font-size: 14px;
        margin-bottom: 7px;
    }

    .stat-value {
        font-size: 27px;
        font-weight: 700;
        color: #172b4d;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }

    .customer-stat .stat-icon {
        background: #eaf2ff;
        color: #2563eb;
    }

    .amount-stat .stat-icon {
        background: #eafaf2;
        color: #16a34a;
    }


    /* =========================
           SECTION
           ========================= */

    .section-title {
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 18px;
        color: #172b4d;
    }


    /* =========================
           FEATURE CARDS
           ========================= */

    .modules-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 18px;
    }

    .module-card {
        position: relative;
        overflow: hidden;
        background: white;
        border: 1px solid #e8edf3;
        border-radius: 18px;
        padding: 24px 20px 20px;
        min-height: 270px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 7px 22px rgba(15, 23, 42, 0.045);
        transition: all 0.25s ease;
    }

        .module-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 32px rgba(15, 23, 42, 0.10);
        }

        .module-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
        }

    .customers-card::before {
        background: #2563eb;
    }

    .accounts-card::before {
        background: #f59e0b;
    }

    .transactions-card::before {
        background: #7c3aed;
    }

    .payments-card::before {
        background: #16a34a;
    }

    .reports-card::before {
        background: #0891b2;
    }

    .ai-card::before {
        background: linear-gradient(135deg, #8b5cf6, #ec4899);
    }


    /* =========================
           FEATURE ICONS
           ========================= */

    .module-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        margin-bottom: 18px;
    }

    .customers-card .module-icon {
        background: #eaf2ff;
        color: #2563eb;
    }

    .accounts-card .module-icon {
        background: #fff7e6;
        color: #f59e0b;
    }

    .transactions-card .module-icon {
        background: #f1eaff;
        color: #7c3aed;
    }

    .payments-card .module-icon {
        background: #eafaf2;
        color: #16a34a;
    }

    .reports-card .module-icon {
        background: #e6f8fb;
        color: #0891b2;
    }

    .ai-card .module-icon {
        background: #f5f3ff;
        color: #8b5cf6;
    }


    /* =========================
           FEATURE TEXT
           ========================= */

    .module-title {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 7px;
        color: #172b4d;
    }

    .module-description {
        color: #7b8794;
        font-size: 13px;
        line-height: 1.6;
        margin: 0;
    }


    /* =========================
           FEATURE BUTTONS
           ========================= */

    .module-btn {
        margin-top: auto;
        width: 100%;
        padding: 10px 13px;
        border-radius: 10px;
        border: none;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .module-btn i {
            font-size: 14px;
        }


    /* Customers */
    .customers-btn {
        background: #eaf2ff;
        color: #2563eb;
    }

        .customers-btn:hover {
            background: #2563eb;
            color: white;
        }


    /* Accounts */
    .accounts-btn {
        background: #fff7e6;
        color: #d97706;
    }

        .accounts-btn:hover {
            background: #f59e0b;
            color: white;
        }


    /* Transactions */
    .transactions-btn {
        background: #f1eaff;
        color: #7c3aed;
    }

        .transactions-btn:hover {
            background: #7c3aed;
            color: white;
        }


    /* Payments */
    .payments-btn {
        background: #eafaf2;
        color: #16a34a;
    }

        .payments-btn:hover {
            background: #16a34a;
            color: white;
        }


    /* Reports */
    .reports-btn {
        background: #e6f8fb;
        color: #0891b2;
    }

        .reports-btn:hover {
            background: #0891b2;
            color: white;
        }

    /* AI Assistant */
    .ai-btn {
        background: #f5f3ff;
        color: #7c3aed;
    }

        .ai-btn:hover {
            background: linear-gradient(135deg, #7c3aed, #9333ea);
            color: white;
        }


    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 1150px) {

        .modules-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 800px) {

        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .header-right {
            width: 100%;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .modules-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 550px) {

        .dashboard-container {
            padding: 25px 15px;
        }

        .header-left {
            align-items: flex-start;
        }

        .bank-logo {
            width: 52px;
            height: 52px;
            font-size: 23px;
        }

        .dashboard-title {
            font-size: 23px;
        }

        .header-right {
            flex-direction: column;
            align-items: stretch;
        }

        .date-box,
        .signout-btn {
            justify-content: center;
        }

        .modules-grid {
            grid-template-columns: 1fr;
        }
    }
</style>


<div class="dashboard-container">


    <!-- =========================
         HEADER
         ========================= -->

    <div class="dashboard-header">

        <div class="header-left">

            <div class="bank-logo">
                <i class="bi bi-bank2"></i>
            </div>

            <div>

                <div class="welcome-text">
                    Welcome back 👋
                </div>

                <h1 class="dashboard-title">
                    Banking Management
                </h1>

                <p class="dashboard-subtitle">
                    Manage customers, accounts and banking operations from one place.
                </p>

            </div>

        </div>


        <div class="header-right">

            <div class="date-box">

                <i class="bi bi-calendar-event"></i>

                <span>
                    @DateTime.Now.ToString("dd MMM yyyy")
                </span>

            </div>


            <a asp-controller="Auth"
               asp-action="Login"
               class="signout-btn">

                <i class="bi bi-box-arrow-right"></i>

                Sign Out

            </a>

        </div>

    </div>



    <!-- =========================
         STATISTICS
         ========================= -->

    <div class="stats-grid">


        <!-- Total Customers -->

        <div class="stat-card customer-stat">

            <div>

                <div class="stat-label">
                    Total Customers
                </div>

                <div class="stat-value">
                    @(Model?.TotalCustomers ?? 0)
                </div>

            </div>


            <div class="stat-icon">

                <i class="bi bi-people-fill"></i>

            </div>

        </div>



        <!-- Total Amount -->

        <div class="stat-card amount-stat">

            <div>

                <div class="stat-label">
                    Total Amount
                </div>

                <div class="stat-value" title="₹@((Model?.TotalAmount ?? 0m).ToString("N2"))">
                    @(Model?.FormattedTotalAmount ?? "₹0.00")
                </div>

            </div>


            <div class="stat-icon">

                <i class="bi bi-wallet2"></i>

            </div>

        </div>

    </div>



    <!-- =========================
         BANKING FEATURES
         ========================= -->

    <div>

        <div class="section-title">
            Banking Features
        </div>


        <div class="modules-grid">


            <!-- =====================
                 CUSTOMERS
                 ===================== -->

            <div class="module-card customers-card">

                <div class="module-icon">

                    <i class="bi bi-people-fill"></i>

                </div>


                <div class="module-title">
                    Customers
                </div>


                <p class="module-description">
                    Add, update and manage customer information.
                </p>


                <a asp-controller="Customer"
                   asp-action="Index"
                   class="module-btn customers-btn">

                    <i class="bi bi-person-lines-fill"></i>

                    Manage Customers

                </a>

            </div>



            <!-- =====================
                 ACCOUNTS
                 ===================== -->

            <div class="module-card accounts-card">

                <div class="module-icon">

                    <i class="bi bi-bank2"></i>

                </div>


                <div class="module-title">
                    Accounts
                </div>


                <p class="module-description">
                    Manage bank accounts, balances and account status.
                </p>


                <a asp-controller="Account"
                   asp-action="Index"
                   class="module-btn accounts-btn">

                    <i class="bi bi-bank"></i>

                    Manage Accounts

                </a>

            </div>



            <!-- =====================
                 TRANSACTIONS
                 ===================== -->

            <div class="module-card transactions-card">

                <div class="module-icon">

                    <i class="bi bi-arrow-left-right"></i>

                </div>


                <div class="module-title">
                    Transactions
                </div>


                <p class="module-description">
                    Manage deposits, withdrawals and account transfers.
                </p>


                <a asp-controller="Transaction"
                   asp-action="Index"
                   class="module-btn transactions-btn">

                    <i class="bi bi-arrow-left-right"></i>

                    Manage Transactions

                </a>

            </div>



            <!-- =====================
                 PAYMENTS
                 ===================== -->

            <div class="module-card payments-card">

                <div class="module-icon">

                    <i class="bi bi-credit-card-2-front-fill"></i>

                </div>


                <div class="module-title">
                    Payments
                </div>


                <p class="module-description">
                    Manage payment services and future payment operations.
                </p>


                <a asp-controller="Payment"
                   asp-action="Index"
                   class="module-btn payments-btn">

                    <i class="bi bi-arrow-right-circle"></i>

                    Explore Payments

                </a>

            </div>



            <!-- =====================
                 AI ASSISTANT
                 ===================== -->

            <div class="module-card ai-card">

                <div class="module-icon">

                    <i class="bi bi-robot"></i>

                </div>


                <div class="module-title d-flex align-items-center justify-content-between">
                    <span>AI Assistant</span>
                    <span class="badge" style="background: linear-gradient(135deg, #8b5cf6, #ec4899); color: white; font-size: 10px; font-weight: 700; border-radius: 6px; padding: 3px 6px;">AI</span>
                </div>


                <p class="module-description">
                    Instant analytics on transactions, active accounts & customer lookups.
                </p>


                <a asp-controller="Chat"
                   asp-action="Index"
                   class="module-btn ai-btn">

                    <i class="bi bi-stars"></i>

                    Open Assistant

                </a>

            </div>



            <!-- =====================
                 REPORTS
                 ===================== -->

            <div class="module-card reports-card">

                <div class="module-icon">

                    <i class="bi bi-bar-chart-fill"></i>

                </div>


                <div class="module-title">
                    Reports
                </div>


                <p class="module-description">
                    View transaction, account and customer reports.
                </p>


                <a asp-controller="Report"
                   asp-action="Index"
                   class="module-btn reports-btn">

                    <i class="bi bi-arrow-right-circle"></i>

                    Explore Reports

                </a>

            </div>


        </div>

    </div>

</div>