@model BankingManagement.Web.Models.CreateAccountModel;


@{
    ViewData["Title"] = "Create Account";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-6">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h3 class="fw-bold mb-1">
                        Create Account
                    </h3>

                    <p class="text-muted mb-0">
                        Create a new bank account for a customer.
                    </p>
                </div>


                <div class="card-body p-4">

                    <form asp-action="Add"
                          method="post">

                        <!-- Customer -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Customer
                            </label>

                            <select asp-for="CustomerId"
                                    class="form-select">

                                <option value="">
                                    -- Select Customer --
                                </option>

                                @foreach (var customer in ViewBag.Customers)
                                {
                                    <option value="@customer.CustomerId">
                                        @customer.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CustomerId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Balance -->
                        <div class="mb-3">

                            <label asp-for="Balance"
                                   class="form-label fw-semibold">
                                Initial Balance
                            </label>

                            <input asp-for="Balance"
                                   type="number"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Enter initial balance" />

                            <span asp-validation-for="Balance"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Status -->
                        <div class="mb-4">

                            <label asp-for="Status"
                                   class="form-label fw-semibold">
                                Account Status
                            </label>

                            <select asp-for="Status"
                                    class="form-select">

                                <option value="">
                                    -- Select Status --
                                </option>

                                <option value="Active">
                                    Active
                                </option>

                                <option value="Inactive">
                                    Inactive
                                </option>

                            </select>

                            <span asp-validation-for="Status"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-bank me-1"></i>
                                Create Account

                            </button>

                            <a asp-controller="Account"
                               asp-action="Index"
                               class="btn btn-secondary px-4">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

