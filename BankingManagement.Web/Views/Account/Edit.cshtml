
@model BankingManagement.Web.Models.EditAccount

@{
    ViewData["Title"] = "Edit Account";
}

<div class="container mt-5">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Edit Account</h1>
        <p class="text-muted fs-5">Update account details</p>

        <a asp-controller="Account"
           asp-action="Index"
           class="text-decoration-none">
            <i class="bi bi-arrow-left"></i> Back to Accounts
        </a>
    </div>


    <!-- Form Card -->
    <div class="card shadow-sm p-4">

        <form asp-controller="Account"
              asp-action="Edit"
              method="post">

            <!-- Account ID -->
            <input type="hidden" asp-for="AccountId" />


            <!-- Account Number - Read Only -->
            <div class="row mb-4">

                <label class="col-md-3 col-form-label fw-semibold">
                    Account Number
                </label>

                <div class="col-md-7">

                    <div class="input-group">

                        <input asp-for="AccountNumber"
                               class="form-control bg-light text-muted"
                               readonly />

                        <span class="input-group-text bg-light text-muted">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                    </div>

                    <small class="text-muted">
                        Account number cannot be changed.
                    </small>

                </div>
            </div>


            <!-- Customer Name - Read Only -->
            <div class="row mb-4">

                <label class="col-md-3 col-form-label fw-semibold">
                    Customer Name
                </label>

                <div class="col-md-7">

                    <div class="input-group">

                        <input asp-for="CustomerName"
                               class="form-control bg-light text-muted"
                               readonly />

                        <span class="input-group-text bg-light text-muted">
                            <i class="bi bi-lock-fill"></i>
                        </span>

                    </div>

                    <small class="text-muted">
                        Customer name cannot be changed.
                    </small>

                </div>
            </div>


            <!-- Balance - Editable -->
            <div class="row mb-4">

                <label asp-for="Balance"
                       class="col-md-3 col-form-label fw-semibold">
                    Balance
                </label>

                <div class="col-md-7">

                    <div class="input-group">

                        <span class="input-group-text">₹</span>

                        <input asp-for="Balance"
                               type="number"
                               step="0.01"
                               class="form-control" />

                    </div>

                    <span asp-validation-for="Balance"
                          class="text-danger">
                    </span>

                </div>
            </div>


            <!-- Status - Editable -->
            <div class="row mb-4">

                <label asp-for="Status"
                       class="col-md-3 col-form-label fw-semibold">
                    Status
                </label>

                <div class="col-md-7">

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>

                    </select>

                    <span asp-validation-for="Status"
                          class="text-danger">
                    </span>

                </div>
            </div>


            <hr />


            <!-- Buttons -->
            <div class="mt-4">

                <button type="submit"
                        class="btn btn-primary px-4 me-2">

                    <i class="bi bi-save"></i>
                    Save Changes

                </button>

                <a asp-controller="Account"
                   asp-action="Index"
                   class="btn btn-outline-secondary px-4">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

