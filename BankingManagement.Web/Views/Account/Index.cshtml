@model List<BankingManagement.Web.Models.AccountModel>

@{
    ViewData["Title"] = "Accounts";
}

<div class="container-fluid px-5 mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <h1 class="fw-bold mb-1">Accounts</h1>
            <p class="text-muted fs-5 mb-0">
                Manage your customer accounts
            </p>
        </div>

        <a asp-controller="Account"
           asp-action="Add"
           class="btn btn-primary px-4 py-2">
            <i class="bi bi-person-plus"></i>
            Add Account
        </a>

    </div>


    <!-- Account Table -->
    <div class="table-responsive">

        <table class="table table-hover align-middle">

            <thead class="table-light">

                <tr>
                    <th class="px-4">S.No</th>
                    <th>Account Number</th>
                    <th>Customer</th>
                    <th>Balance</th>
                    <th>Status</th>
                   @* <th>Created Date</th> *@
                    <th class="text-center">Actions</th>
                </tr>

            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    int serialNo = 1;

                    foreach (var account in Model)
                    {
                        <tr>

                            <!-- S.No -->
                            <td class="px-4">
                                @serialNo
                            </td>

                            <!-- Account Number -->
                            <td>
                                @account.AccountNumber
                            </td>

                            <!-- Customer Name -->
                            <td class="fw-semibold">
                                @account.CustomerName
                            </td>

                            <!-- Balance -->
                            <td>
                                ₹@account.Balance.ToString("N2")
                            </td>

                            <!-- Status -->
                            <td>
                                @if (account.Status == "Active")
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @account.Status
                                    </span>
                                }
                            </td>

                            <!-- Created Date -->
                            @* <td>
                                @account.CreatedDate.ToString("dd-MM-yyyy")
                            </td> *@

                            <!-- Actions -->
                            <td class="text-center">

                                <a asp-controller="Account"
                                   asp-action="Edit"
                                   asp-route-id="@account.AccountId"
                                   class="btn btn-outline-primary btn-sm me-2"
                                   title="Edit">

                                    <i class="bi bi-pencil"></i>

                                </a>

                                <a asp-controller="Account"
                                   asp-action="Delete"
                                   asp-route-id="@account.AccountId"
                                   class="btn btn-outline-danger btn-sm"
                                   title="Delete">

                                    <i class="bi bi-trash"></i>

                                </a>

                            </td>

                        </tr>

                        serialNo++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">
                            No accounts found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>