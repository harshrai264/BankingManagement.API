<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BankingManagement.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BankingManagement.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="d-flex flex-column h-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BankingManagement.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-primary fw-semibold" asp-controller="Chat" asp-action="Index">
                                <i class="bi bi-stars"></i> AI Assistant
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-shrink-0">
        @RenderBody()
    </main>

    <!-- Floating AI Chatbot Widget -->
    <div id="aiChatWidget" class="ai-chat-widget">
        <!-- Floating Toggle Button -->
        <button type="button" id="chatWidgetBtn" class="chat-widget-toggle" onclick="toggleChatWidget()" title="AI Banking Assistant">
            <i class="bi bi-stars"></i>
            <span class="widget-pulse"></span>
        </button>

        <!-- Chat Popup Box -->
        <div id="chatWidgetPopup" class="chat-widget-popup hidden">
            <!-- Header -->
            <div class="widget-header">
                <div class="widget-header-title">
                    <div class="widget-icon">
                        <i class="bi bi-stars"></i>
                    </div>
                    <div>
                        <strong>Banking AI</strong>
                        <span class="widget-status"><span class="status-dot"></span> Online</span>
                    </div>
                </div>
                <div class="widget-header-actions">
                    <a asp-controller="Chat" asp-action="Index" class="widget-action-btn" title="Open Fullscreen Assistant">
                        <i class="bi bi-arrows-angle-expand"></i>
                    </a>
                    <button type="button" class="widget-action-btn" onclick="toggleChatWidget()" title="Close">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- Messages List -->
            <div id="widgetMessages" class="widget-messages">
                <div class="widget-msg widget-msg-bot">
                    <p class="mb-1">👋 <strong>Hi! I'm your Banking AI.</strong></p>
                    <p class="mb-2">Ask questions about transactions, active customer accounts, or balances.</p>
                    <div class="widget-suggestions">
                        <button type="button" class="w-suggestion-btn" onclick="askWidgetPreset('Which customer has most transactions')">🥇 Most active customer</button>
                        <button type="button" class="w-suggestion-btn" onclick="askWidgetPreset('Customers with balance less than 1000')">📉 Customers with balance &lt; 1000</button>
                        <button type="button" class="w-suggestion-btn" onclick="askWidgetPreset('Total transactions in last month')">📊 Total transactions in last month</button>
                        <button type="button" class="w-suggestion-btn" onclick="askWidgetPreset('Total bank balance')">💰 Total bank balance</button>
                    </div>
                </div>
            </div>

            <!-- Input Bar -->
            <div class="widget-input-bar">
                <form id="widgetChatForm" onsubmit="handleWidgetSubmit(event)">
                    <div class="widget-input-wrapper">
                        <input type="text" id="widgetChatInput" placeholder="Ask a question..." autocomplete="off" />
                        <button type="submit" id="widgetSendBtn" class="widget-send-btn">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <style>
        .ai-chat-widget {
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 1080;
            font-family: inherit;
        }

        .chat-widget-toggle {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            color: white;
            font-size: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 8px 25px rgba(37, 99, 235, 0.4);
            position: relative;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .chat-widget-toggle:hover {
            transform: scale(1.08);
            box-shadow: 0 12px 30px rgba(37, 99, 235, 0.5);
        }

        .widget-pulse {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.4);
            animation: widgetPulseAnim 2.5s infinite;
            z-index: -1;
        }

        @@keyframes widgetPulseAnim {
            0% { transform: scale(1); opacity: 0.8; }
            100% { transform: scale(1.4); opacity: 0; }
        }

        .chat-widget-popup {
            position: absolute;
            bottom: 72px;
            right: 0;
            width: 375px;
            height: 530px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 15px 45px rgba(15, 23, 42, 0.18);
            border: 1px solid #e5e7eb;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            animation: widgetSlideUp 0.28s ease-out;
        }

        .chat-widget-popup.hidden {
            display: none !important;
        }

        @@keyframes widgetSlideUp {
            from { opacity: 0; transform: translateY(18px) scale(0.96); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .widget-header {
            padding: 14px 18px;
            background: linear-gradient(135deg, #1e293b, #0f172a);
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .widget-header-title {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .widget-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .widget-status {
            display: block;
            font-size: 11px;
            color: #10b981;
            font-weight: 500;
        }

        .status-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #10b981;
            margin-right: 4px;
        }

        .widget-header-actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .widget-action-btn {
            background: rgba(255, 255, 255, 0.12);
            border: none;
            color: white;
            width: 30px;
            height: 30px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            cursor: pointer;
            text-decoration: none;
            transition: .2s;
        }

        .widget-action-btn:hover {
            background: rgba(255, 255, 255, 0.22);
            color: white;
        }

        .widget-messages {
            flex: 1;
            padding: 16px;
            overflow-y: auto;
            background: #f8fafc;
            display: flex;
            flex-direction: column;
            gap: 12px;
            font-size: 13px;
        }

        .widget-msg {
            max-width: 88%;
            padding: 10px 14px;
            border-radius: 14px;
            line-height: 1.5;
            word-break: break-word;
        }

        .widget-msg-bot {
            align-self: flex-start;
            background: white;
            border: 1px solid #e2e8f0;
            color: #1e293b;
            border-top-left-radius: 3px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        .widget-msg-user {
            align-self: flex-end;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: white;
            border-top-right-radius: 3px;
            box-shadow: 0 2px 8px rgba(37, 99, 235, 0.2);
        }

        .widget-suggestions {
            margin-top: 8px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .w-suggestion-btn {
            border: 1px solid #dbe1ea;
            background: #f1f5f9;
            color: #2563eb;
            font-size: 11.5px;
            font-weight: 600;
            padding: 5px 10px;
            border-radius: 8px;
            text-align: left;
            cursor: pointer;
            transition: .15s;
        }

        .w-suggestion-btn:hover {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
        }

        .widget-input-bar {
            padding: 12px;
            background: white;
            border-top: 1px solid #eef2f7;
        }

        .widget-input-wrapper {
            display: flex;
            align-items: center;
            border: 1px solid #dbe1ea;
            border-radius: 12px;
            padding: 3px 4px 3px 12px;
            background: #fff;
            transition: .2s;
        }

        .widget-input-wrapper:focus-within {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .widget-input-wrapper input {
            flex: 1;
            height: 38px;
            border: none;
            outline: none;
            font-size: 13px;
            color: #1e293b;
        }

        .widget-send-btn {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            border: none;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            cursor: pointer;
            transition: .2s;
        }

        .widget-send-btn:hover {
            opacity: 0.9;
        }

        .widget-typing-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #94a3b8;
            display: inline-block;
            animation: typingAnimation 1.4s infinite ease-in-out;
        }

        .widget-typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .widget-typing-dot:nth-child(3) { animation-delay: 0.4s; }

        @@media (max-width: 480px) {
            .chat-widget-popup {
                width: calc(100vw - 30px);
                right: -10px;
                bottom: 70px;
                height: 480px;
            }
        }
    </style>

    <script>
        function toggleChatWidget() {
            const popup = document.getElementById("chatWidgetPopup");
            if (popup) {
                popup.classList.toggle("hidden");
                if (!popup.classList.contains("hidden")) {
                    const inp = document.getElementById("widgetChatInput");
                    if (inp) inp.focus();
                }
            }
        }

        function formatWidgetMarkdown(text) {
            if (!text) return "";
            return text
                .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
                .replace(/\*(.*?)\*/g, "<em>$1</em>")
                .replace(/\n\n/g, "<br/><br/>")
                .replace(/\n/g, "<br/>")
                .replace(/•\s+/g, "&bull; ");
        }

        function appendWidgetUserMessage(text) {
            const container = document.getElementById("widgetMessages");
            const div = document.createElement("div");
            div.className = "widget-msg widget-msg-user";
            div.textContent = text;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        function appendWidgetBotTyping() {
            const container = document.getElementById("widgetMessages");
            const div = document.createElement("div");
            div.id = "widgetTypingIndicator";
            div.className = "widget-msg widget-msg-bot";
            div.innerHTML = `<span class="widget-typing-dot"></span> <span class="widget-typing-dot"></span> <span class="widget-typing-dot"></span>`;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        function removeWidgetBotTyping() {
            const el = document.getElementById("widgetTypingIndicator");
            if (el) el.remove();
        }

        function appendWidgetBotMessage(reply, suggestions = []) {
            removeWidgetBotTyping();
            const container = document.getElementById("widgetMessages");
            const div = document.createElement("div");
            div.className = "widget-msg widget-msg-bot";

            let suggHtml = "";
            if (suggestions && suggestions.length > 0) {
                suggHtml = `<div class="widget-suggestions mt-2">` +
                    suggestions.map(s => `<button type="button" class="w-suggestion-btn" onclick="askWidgetPreset('${s.replace(/'/g, "\\'")}')">${s}</button>`).join('') +
                    `</div>`;
            }

            div.innerHTML = `<div>${formatWidgetMarkdown(reply)}</div>${suggHtml}`;
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        async function sendWidgetQuery(text) {
            if (!text || text.trim() === "") return;

            appendWidgetUserMessage(text);
            appendWidgetBotTyping();
            const sendBtn = document.getElementById("widgetSendBtn");
            if (sendBtn) sendBtn.disabled = true;

            try {
                const res = await fetch("/Chat/Ask", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ message: text })
                });

                if (res.ok) {
                    const data = await res.json();
                    appendWidgetBotMessage(data.reply || "No reply received.", data.suggestions);
                } else {
                    appendWidgetBotMessage("⚠️ Sorry, could not process your query right now.");
                }
            } catch (e) {
                appendWidgetBotMessage("⚠️ Network error while connecting to assistant.");
            } finally {
                if (sendBtn) sendBtn.disabled = false;
                const inp = document.getElementById("widgetChatInput");
                if (inp) inp.focus();
            }
        }

        function handleWidgetSubmit(e) {
            e.preventDefault();
            const inp = document.getElementById("widgetChatInput");
            if (inp && inp.value.trim()) {
                const val = inp.value.trim();
                inp.value = "";
                sendWidgetQuery(val);
            }
        }

        function askWidgetPreset(text) {
            sendWidgetQuery(text);
        }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>