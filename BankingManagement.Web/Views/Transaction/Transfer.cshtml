@model BankingManagement.Web.Models.TransferModel

@{
    ViewData["Title"] = "Transfer Money";

    var accounts = ViewBag.Accounts
        as List<BankingManagement.Web.Models.AccountSelectionModel>
        ?? new List<BankingManagement.Web.Models.AccountSelectionModel>();
}

<div class="transfer-wrapper">

    <!-- Page Header -->
    <div class="page-header">

        <a asp-controller="Transaction"
           asp-action="Index"
           class="back-button">
            <i class="bi bi-arrow-left"></i>
            Transactions
        </a>

        <div class="header-content">

            <div class="header-icon">
                <i class="bi bi-arrow-left-right"></i>
            </div>

            <div>
                <h1>Transfer Money</h1>
                <p>Transfer funds securely between customer bank accounts</p>
            </div>

        </div>

    </div>

    <!-- Notification Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-banner success-banner" id="successAlert" role="alert">
            <div class="banner-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="banner-content">
                <strong>Transfer Successful!</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button type="button" class="banner-close" onclick="dismissAlert('successAlert')" aria-label="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-banner error-banner" id="errorAlert" role="alert">
            <div class="banner-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="banner-content">
                <strong>Transfer Failed</strong>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button type="button" class="banner-close" onclick="dismissAlert('errorAlert')" aria-label="Close">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    }

    <!-- Main Card -->
    <div class="transfer-main-card">

        <form asp-controller="Transaction"
              asp-action="Transfer"
              method="post"
              id="transferForm">

            <!-- Hidden Selected Account IDs -->
            <input asp-for="FromAccountId"
                   type="hidden"
                   id="FromAccountId" />

            <input asp-for="ToAccountId"
                   type="hidden"
                   id="ToAccountId" />


            <!-- SENDER (FROM) ACCOUNT SECTION -->
            <div class="section">

                <div class="section-heading">

                    <div class="section-icon sender-color">
                        <i class="bi bi-box-arrow-up-right"></i>
                    </div>

                    <div>
                        <h3>Sender Account (From)</h3>
                        <p>Select the account from which money will be debited</p>
                    </div>

                </div>

                <!-- Sender Selection Area -->
                <div id="senderSelectionArea">

                    <div class="search-container">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               id="senderSearch"
                               placeholder="Search sender by name or account number..."
                               autocomplete="off" />
                    </div>

                    <div class="account-count">
                        <span>
                            <i class="bi bi-check-circle-fill"></i>
                            @accounts.Count active account(s) available
                        </span>
                    </div>

                    <div class="account-list" id="senderList">
                        @if (accounts.Any())
                        {
                            foreach (var account in accounts)
                            {
                                <div class="account-card sender-card-item"
                                     data-id="@account.AccountId"
                                     data-name="@account.CustomerName"
                                     data-number="@account.AccountNumber"
                                     data-balance="@account.Balance">

                                    <div class="customer-avatar sender-avatar-icon">
                                        <i class="bi bi-person-fill"></i>
                                    </div>

                                    <div class="account-information">
                                        <div class="customer-name">
                                            @account.CustomerName
                                        </div>
                                        <div class="account-number">
                                            <i class="bi bi-credit-card-2-front"></i>
                                            @account.AccountNumber
                                        </div>
                                    </div>

                                    <div class="balance-information">
                                        <span>Available Balance</span>
                                        <strong>₹@account.Balance.ToString("N2")</strong>
                                    </div>

                                    <div class="arrow-icon">
                                        <i class="bi bi-chevron-right"></i>
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="bi bi-wallet2"></i>
                                <h4>No Active Accounts</h4>
                                <p>There are no active accounts available for transfer.</p>
                            </div>
                        }
                    </div>

                </div>

                <!-- Selected Sender Account Card -->
                <div id="selectedSenderCard" class="selected-account-card sender-selected hidden">

                    <div class="selected-top">
                        <div class="selected-label">
                            <i class="bi bi-check-circle-fill"></i>
                            Sender Selected (Debit)
                        </div>
                        <button type="button" id="changeSender">
                            Change Sender
                        </button>
                    </div>

                    <div class="selected-account-content">
                        <div class="selected-avatar sender-avatar-style">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="selected-customer">
                            <h4 id="selectedSenderCustomer"></h4>
                            <span id="selectedSenderNumber"></span>
                        </div>
                        <div class="selected-balance">
                            <span>Available Balance</span>
                            <strong id="selectedSenderBalance"></strong>
                        </div>
                    </div>

                </div>

            </div>


            <!-- TRANSFER DIRECTION INDICATOR -->
            <div class="transfer-arrow-divider">
                <div class="transfer-arrow-badge">
                    <i class="bi bi-arrow-down"></i>
                </div>
            </div>


            <!-- RECEIVER (TO) ACCOUNT SECTION -->
            <div class="section">

                <div class="section-heading">

                    <div class="section-icon receiver-color">
                        <i class="bi bi-box-arrow-in-down-left"></i>
                    </div>

                    <div>
                        <h3>Receiver Account (To)</h3>
                        <p>Select the beneficiary account where money will be credited</p>
                    </div>

                </div>

                <!-- Receiver Selection Area -->
                <div id="receiverSelectionArea">

                    <div class="search-container">
                        <i class="bi bi-search"></i>
                        <input type="text"
                               id="receiverSearch"
                               placeholder="Search receiver by name or account number..."
                               autocomplete="off" />
                    </div>

                    <div class="account-count">
                        <span id="receiverCountText">
                            <i class="bi bi-check-circle-fill"></i>
                            Select a sender account first
                        </span>
                    </div>

                    <div class="account-list" id="receiverList">
                        @if (accounts.Any())
                        {
                            foreach (var account in accounts)
                            {
                                <div class="account-card receiver-card-item"
                                     data-id="@account.AccountId"
                                     data-name="@account.CustomerName"
                                     data-number="@account.AccountNumber"
                                     data-balance="@account.Balance">

                                    <div class="customer-avatar receiver-avatar-icon">
                                        <i class="bi bi-person-fill"></i>
                                    </div>

                                    <div class="account-information">
                                        <div class="customer-name">
                                            @account.CustomerName
                                        </div>
                                        <div class="account-number">
                                            <i class="bi bi-credit-card-2-front"></i>
                                            @account.AccountNumber
                                        </div>
                                    </div>

                                    <div class="balance-information">
                                        <span>Current Balance</span>
                                        <strong style="color: #6366f1;">₹@account.Balance.ToString("N2")</strong>
                                    </div>

                                    <div class="arrow-icon">
                                        <i class="bi bi-chevron-right"></i>
                                    </div>

                                </div>
                            }
                        }
                    </div>

                </div>

                <!-- Selected Receiver Account Card -->
                <div id="selectedReceiverCard" class="selected-account-card receiver-selected hidden">

                    <div class="selected-top">
                        <div class="selected-label receiver-label">
                            <i class="bi bi-check-circle-fill"></i>
                            Receiver Selected (Credit)
                        </div>
                        <button type="button" id="changeReceiver">
                            Change Receiver
                        </button>
                    </div>

                    <div class="selected-account-content">
                        <div class="selected-avatar receiver-avatar-style">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div class="selected-customer">
                            <h4 id="selectedReceiverCustomer"></h4>
                            <span id="selectedReceiverNumber"></span>
                        </div>
                        <div class="selected-balance">
                            <span>Current Balance</span>
                            <strong id="selectedReceiverBalance"></strong>
                        </div>
                    </div>

                </div>

            </div>


            <!-- DIVIDER -->
            <div class="section-divider"></div>


            <!-- TRANSFER DETAILS SECTION -->
            <div class="section">

                <div class="section-heading">

                    <div class="section-icon details-color">
                        <i class="bi bi-cash-coin"></i>
                    </div>

                    <div>
                        <h3>Transfer Details</h3>
                        <p>Specify the amount and optional transaction reference note</p>
                    </div>

                </div>

                <div class="transfer-form">

                    <!-- Amount -->
                    <div class="form-field">

                        <label>
                            Transfer Amount
                            <span>*</span>
                        </label>

                        <div class="amount-box" id="amountBox">
                            <div class="currency">₹</div>
                            <input asp-for="Amount"
                                   id="Amount"
                                   type="number"
                                   min="1"
                                   step="0.01"
                                   placeholder="Enter transfer amount" />
                        </div>

                        <!-- Insufficient balance warning -->
                        <div id="balanceWarning" class="balance-warning hidden">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>Amount exceeds sender available balance of <strong id="maxBalanceText">₹0.00</strong></span>
                        </div>

                        <span asp-validation-for="Amount" class="validation-message"></span>

                    </div>

                    <!-- Description -->
                    <div class="form-field">

                        <label>
                            Description / Purpose
                        </label>

                        <input asp-for="Description"
                               id="Description"
                               class="text-input"
                               placeholder="e.g. Rent, invoice payment, family support..." />

                        <span asp-validation-for="Description" class="validation-message"></span>

                    </div>

                </div>

            </div>


            <!-- API / MODEL ERROR -->
            <div asp-validation-summary="ModelOnly" class="form-error"></div>


            <!-- FOOTER -->
            <div class="form-footer">

                <a asp-controller="Transaction"
                   asp-action="Index"
                   class="cancel-button">
                    Cancel
                </a>

                <button type="submit"
                        id="transferButton"
                        class="submit-button"
                        disabled>
                    <i class="bi bi-arrow-left-right"></i>
                    Submit Transfer
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    body {
        background: #f5f7fb;
    }

    /* =========================
           PAGE
           ========================= */

    .transfer-wrapper {
        max-width: 1050px;
        margin: 30px auto;
        padding: 0 20px;
    }

    /* =========================
           HEADER
           ========================= */

    .page-header {
        margin-bottom: 25px;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 20px;
        transition: .2s;
    }

        .back-button:hover {
            color: #7c3aed;
        }

    .header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 25px;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        box-shadow: 0 8px 20px rgba(124, 58, 237, .25);
    }

    .header-content h1 {
        margin: 0;
        font-size: 27px;
        font-weight: 750;
        color: #1e293b;
    }

    .header-content p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    /* =========================
           ALERT BANNERS
           ========================= */

    .alert-banner {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 20px;
        border-radius: 14px;
        margin-bottom: 24px;
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.12);
        animation: slideDownFade 0.35s ease-out forwards;
        position: relative;
    }

    .success-banner {
        background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
        border: 1px solid #86efac;
        color: #065f46;
    }

    .error-banner {
        background: linear-gradient(135deg, #fef2f2, #fff1f2);
        border: 1px solid #fecaca;
        color: #991b1b;
        box-shadow: 0 6px 20px rgba(239, 68, 68, 0.12);
    }

    .banner-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .success-banner .banner-icon {
        background: #d1fae5;
        color: #059669;
    }

    .error-banner .banner-icon {
        background: #fee2e2;
        color: #dc2626;
    }

    .banner-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .banner-content strong {
        font-size: 15px;
        font-weight: 700;
    }

    .banner-content span {
        font-size: 13.5px;
        opacity: 0.95;
    }

    .banner-close {
        background: transparent;
        border: none;
        color: inherit;
        opacity: 0.6;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: opacity 0.2s, background-color 0.2s;
    }

    .banner-close:hover {
        opacity: 1;
        background-color: rgba(0, 0, 0, 0.06);
    }

    @@keyframes slideDownFade {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================
           MAIN CARD
           ========================= */

    .transfer-main-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        box-shadow: 0 10px 35px rgba(15, 23, 42, .07);
        overflow: hidden;
    }

    .section {
        padding: 28px 30px;
    }

    /* =========================
           SECTION HEADING
           ========================= */

    .section-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .sender-color {
        background: #fdf2f8;
        color: #db2777;
    }

    .receiver-color {
        background: #eef2ff;
        color: #6366f1;
    }

    .details-color {
        background: #f5f3ff;
        color: #7c3aed;
    }

    .section-heading h3 {
        margin: 0;
        font-size: 17px;
        font-weight: 700;
        color: #1e293b;
    }

    .section-heading p {
        margin: 3px 0 0;
        color: #64748b;
        font-size: 12px;
    }

    /* =========================
           DIRECTION ARROW
           ========================= */

    .transfer-arrow-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        height: 2px;
        background: #eef2f7;
        margin: 0 30px;
    }

    .transfer-arrow-badge {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #7c3aed;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
    }

    /* =========================
           SEARCH
           ========================= */

    .search-container {
        position: relative;
    }

        .search-container i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 17px;
        }

        .search-container input {
            width: 100%;
            height: 48px;
            border: 1px solid #dbe1ea;
            border-radius: 11px;
            padding: 0 15px 0 45px;
            outline: none;
            font-size: 14px;
            transition: .2s;
        }

            .search-container input:focus {
                border-color: #7c3aed;
                box-shadow: 0 0 0 3px rgba(124, 58, 237, .12);
            }

    .account-count {
        margin: 10px 0;
        font-size: 12px;
        color: #64748b;
    }

        .account-count i {
            color: #16a34a;
            margin-right: 5px;
        }

    /* =========================
           ACCOUNT LIST
           ========================= */

    .account-list {
        border: 1px solid #e5e7eb;
        border-radius: 13px;
        max-height: 240px;
        overflow-y: auto;
        background: #fff;
    }

    .account-card {
        display: flex;
        align-items: center;
        padding: 13px 17px;
        border-bottom: 1px solid #eef2f7;
        cursor: pointer;
        transition: background .2s, transform .15s;
    }

        .account-card:last-child {
            border-bottom: none;
        }

        .account-card:hover {
            background: #faf8ff;
            transform: translateX(2px);
        }

    .customer-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 13px;
        flex-shrink: 0;
    }

    .sender-avatar-icon {
        background: #fdf2f8;
        color: #db2777;
    }

    .receiver-avatar-icon {
        background: #eef2ff;
        color: #6366f1;
    }

    .account-information {
        flex: 1;
    }

    .customer-name {
        font-size: 14px;
        font-weight: 700;
        color: #1e293b;
    }

    .account-number {
        margin-top: 3px;
        font-size: 12px;
        color: #64748b;
    }

        .account-number i {
            margin-right: 4px;
        }

    .balance-information {
        text-align: right;
        margin-right: 18px;
    }

        .balance-information span {
            display: block;
            font-size: 10px;
            color: #94a3b8;
        }

        .balance-information strong {
            display: block;
            margin-top: 2px;
            color: #16a34a;
            font-size: 14px;
        }

    .arrow-icon {
        color: #94a3b8;
    }

    /* =========================
           EMPTY
           ========================= */

    .empty-state {
        text-align: center;
        padding: 35px 20px;
        color: #64748b;
    }

        .empty-state i {
            font-size: 32px;
            color: #94a3b8;
        }

        .empty-state h4 {
            margin: 8px 0 4px;
            color: #334155;
            font-size: 15px;
        }

        .empty-state p {
            margin: 0;
            font-size: 13px;
        }

    /* =========================
           SELECTED ACCOUNT CARDS
           ========================= */

    .selected-account-card {
        margin-top: 15px;
        border-radius: 13px;
        padding: 16px 18px;
    }

    .sender-selected {
        background: linear-gradient(135deg, #fdf2f8, #fce7f3);
        border: 1px solid #fbcfe8;
    }

    .receiver-selected {
        background: linear-gradient(135deg, #eef2ff, #e0e7ff);
        border: 1px solid #c7d2fe;
    }

    .hidden {
        display: none !important;
    }

    .selected-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .selected-label {
        font-size: 12px;
        font-weight: 700;
        color: #db2777;
    }

    .receiver-label {
        color: #6366f1 !important;
    }

        .selected-label i {
            margin-right: 5px;
        }

    #changeSender {
        border: none;
        background: transparent;
        color: #db2777;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
    }

    #changeReceiver {
        border: none;
        background: transparent;
        color: #6366f1;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
    }

    .selected-account-content {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .selected-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        box-shadow: 0 3px 10px rgba(0, 0, 0, .08);
    }

    .sender-avatar-style {
        color: #db2777;
    }

    .receiver-avatar-style {
        color: #6366f1;
    }

    .selected-customer {
        flex: 1;
    }

        .selected-customer h4 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
        }

        .selected-customer span {
            display: block;
            margin-top: 3px;
            color: #64748b;
            font-size: 12px;
        }

    .selected-balance {
        text-align: right;
    }

        .selected-balance span {
            display: block;
            color: #64748b;
            font-size: 10px;
        }

        .selected-balance strong {
            display: block;
            margin-top: 3px;
            color: #16a34a;
            font-size: 15px;
        }

    /* =========================
           DIVIDER
           ========================= */

    .section-divider {
        height: 1px;
        background: #eef2f7;
    }

    /* =========================
           FORM
           ========================= */

    .transfer-form {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 20px;
    }

    .form-field label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: 13px;
        font-weight: 650;
    }

        .form-field label span {
            color: #dc2626;
        }

    .amount-box {
        height: 48px;
        display: flex;
        align-items: center;
        border: 1px solid #dbe1ea;
        border-radius: 11px;
        overflow: hidden;
        transition: .2s;
    }

        .amount-box:focus-within {
            border-color: #7c3aed;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, .12);
        }

        .amount-box.border-danger {
            border-color: #dc2626 !important;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, .12) !important;
        }

    .currency {
        height: 100%;
        display: flex;
        align-items: center;
        padding: 0 15px;
        background: #f8fafc;
        border-right: 1px solid #e5e7eb;
        color: #64748b;
        font-weight: 700;
    }

    .amount-box input {
        flex: 1;
        height: 100%;
        border: none;
        outline: none;
        padding: 0 14px;
        font-size: 14px;
    }

    .balance-warning {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 7px;
        font-size: 12px;
        color: #dc2626;
        font-weight: 500;
    }

    .text-input {
        width: 100%;
        height: 48px;
        border: 1px solid #dbe1ea;
        border-radius: 11px;
        padding: 0 14px;
        outline: none;
        font-size: 14px;
        transition: .2s;
    }

        .text-input:focus {
            border-color: #7c3aed;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, .12);
        }

    .validation-message {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 12px;
    }

    .form-error {
        margin: 0 30px 15px;
        color: #dc2626;
        font-size: 13px;
    }

    /* =========================
           FOOTER
           ========================= */

    .form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 20px 30px;
        background: #fafbfe;
        border-top: 1px solid #eef2f7;
    }

    .cancel-button,
    .submit-button {
        height: 44px;
        padding: 0 20px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        transition: .2s;
    }

    .cancel-button {
        background: #f1f5f9;
        color: #475569;
    }

        .cancel-button:hover {
            background: #e2e8f0;
            color: #334155;
        }

    .submit-button {
        border: none;
        color: white;
        background: linear-gradient(135deg, #7c3aed, #4f46e5);
        box-shadow: 0 5px 15px rgba(124, 58, 237, .25);
    }

        .submit-button:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(124, 58, 237, .32);
        }

        .submit-button:disabled {
            opacity: .45;
            cursor: not-allowed;
            box-shadow: none;
        }

    /* =========================
           MOBILE
           ========================= */

    @@media (max-width: 768px) {
        .transfer-wrapper {
            padding: 0 12px;
            margin-top: 20px;
        }

        .section {
            padding: 20px 16px;
        }

        .transfer-form {
            grid-template-columns: 1fr;
        }

        .balance-information {
            display: none;
        }

        .form-footer {
            padding: 16px;
            flex-direction: column-reverse;
        }

        .cancel-button,
        .submit-button {
            width: 100%;
        }
    }

</style>


<script>

    const fromAccountIdInput = document.getElementById("FromAccountId");
    const toAccountIdInput = document.getElementById("ToAccountId");
    const amountInput = document.getElementById("Amount");
    const amountBox = document.getElementById("amountBox");
    const balanceWarning = document.getElementById("balanceWarning");
    const maxBalanceText = document.getElementById("maxBalanceText");
    const transferButton = document.getElementById("transferButton");

    // Sender elements
    const senderSearch = document.getElementById("senderSearch");
    const senderCards = document.querySelectorAll(".sender-card-item");
    const senderSelectionArea = document.getElementById("senderSelectionArea");
    const selectedSenderCard = document.getElementById("selectedSenderCard");
    const selectedSenderCustomer = document.getElementById("selectedSenderCustomer");
    const selectedSenderNumber = document.getElementById("selectedSenderNumber");
    const selectedSenderBalance = document.getElementById("selectedSenderBalance");
    const changeSenderButton = document.getElementById("changeSender");

    // Receiver elements
    const receiverSearch = document.getElementById("receiverSearch");
    const receiverCards = document.querySelectorAll(".receiver-card-item");
    const receiverSelectionArea = document.getElementById("receiverSelectionArea");
    const selectedReceiverCard = document.getElementById("selectedReceiverCard");
    const selectedReceiverCustomer = document.getElementById("selectedReceiverCustomer");
    const selectedReceiverNumber = document.getElementById("selectedReceiverNumber");
    const selectedReceiverBalance = document.getElementById("selectedReceiverBalance");
    const changeReceiverButton = document.getElementById("changeReceiver");

    let senderSelected = false;
    let receiverSelected = false;
    let senderBalance = 0;
    let selectedSenderId = null;
    let selectedReceiverId = null;


    /* =========================
       SENDER SELECTION
       ========================= */

    senderCards.forEach(function (card) {
        card.addEventListener("click", function () {
            const id = card.dataset.id;
            const name = card.dataset.name;
            const number = card.dataset.number;
            const balance = Number(card.dataset.balance);

            selectedSenderId = id;
            fromAccountIdInput.value = id;
            senderBalance = balance;
            senderSelected = true;

            selectedSenderCustomer.textContent = name;
            selectedSenderNumber.textContent = "Account: " + number;
            selectedSenderBalance.textContent = "₹" + balance.toLocaleString("en-IN", { minimumFractionDigits: 2 });
            maxBalanceText.textContent = "₹" + balance.toLocaleString("en-IN", { minimumFractionDigits: 2 });

            senderSelectionArea.classList.add("hidden");
            selectedSenderCard.classList.remove("hidden");

            // Filter receiver cards so sender account cannot be selected as receiver
            updateReceiverAvailability();

            validateForm();
        });
    });

    changeSenderButton.addEventListener("click", function () {
        senderSelectionArea.classList.remove("hidden");
        selectedSenderCard.classList.add("hidden");
        fromAccountIdInput.value = "";
        selectedSenderId = null;
        senderSelected = false;
        senderBalance = 0;

        updateReceiverAvailability();
        validateForm();
        if (senderSearch) senderSearch.focus();
    });


    /* =========================
       RECEIVER SELECTION
       ========================= */

    receiverCards.forEach(function (card) {
        card.addEventListener("click", function () {
            const id = card.dataset.id;
            if (id === selectedSenderId) return; // Prevent same account

            const name = card.dataset.name;
            const number = card.dataset.number;
            const balance = Number(card.dataset.balance);

            selectedReceiverId = id;
            toAccountIdInput.value = id;
            receiverSelected = true;

            selectedReceiverCustomer.textContent = name;
            selectedReceiverNumber.textContent = "Account: " + number;
            selectedReceiverBalance.textContent = "₹" + balance.toLocaleString("en-IN", { minimumFractionDigits: 2 });

            receiverSelectionArea.classList.add("hidden");
            selectedReceiverCard.classList.remove("hidden");

            validateForm();
        });
    });

    changeReceiverButton.addEventListener("click", function () {
        receiverSelectionArea.classList.remove("hidden");
        selectedReceiverCard.classList.add("hidden");
        toAccountIdInput.value = "";
        selectedReceiverId = null;
        receiverSelected = false;

        validateForm();
        if (receiverSearch) receiverSearch.focus();
    });


    function updateReceiverAvailability() {
        receiverCards.forEach(function (card) {
            if (card.dataset.id === selectedSenderId) {
                card.style.display = "none";
                // If receiver was currently the same as new sender, reset receiver
                if (selectedReceiverId === selectedSenderId) {
                    changeReceiverButton.click();
                }
            } else {
                card.style.display = "flex";
            }
        });
    }


    /* =========================
       SEARCH FILTERING
       ========================= */

    if (senderSearch) {
        senderSearch.addEventListener("input", function () {
            const val = this.value.toLowerCase().trim();
            senderCards.forEach(function (card) {
                const name = (card.dataset.name || "").toLowerCase();
                const num = (card.dataset.number || "").toLowerCase();
                card.style.display = (name.includes(val) || num.includes(val)) ? "flex" : "none";
            });
        });
    }

    if (receiverSearch) {
        receiverSearch.addEventListener("input", function () {
            const val = this.value.toLowerCase().trim();
            receiverCards.forEach(function (card) {
                if (card.dataset.id === selectedSenderId) {
                    card.style.display = "none";
                    return;
                }
                const name = (card.dataset.name || "").toLowerCase();
                const num = (card.dataset.number || "").toLowerCase();
                card.style.display = (name.includes(val) || num.includes(val)) ? "flex" : "none";
            });
        });
    }


    /* =========================
       VALIDATE FORM
       ========================= */

    amountInput.addEventListener("input", validateForm);

    function validateForm() {
        const amount = Number(amountInput.value);

        if (!senderSelected || !receiverSelected) {
            transferButton.disabled = true;
            balanceWarning.classList.add("hidden");
            amountBox.classList.remove("border-danger");
            return;
        }

        if (selectedSenderId === selectedReceiverId) {
            transferButton.disabled = true;
            return;
        }

        if (amount > senderBalance) {
            balanceWarning.classList.remove("hidden");
            amountBox.classList.add("border-danger");
            transferButton.disabled = true;
            return;
        } else {
            balanceWarning.classList.add("hidden");
            amountBox.classList.remove("border-danger");
        }

        if (amount > 0) {
            transferButton.disabled = false;
        } else {
            transferButton.disabled = true;
        }
    }


    /* =========================
       DISMISS ALERT
       ========================= */

    function dismissAlert(alertId) {
        const el = document.getElementById(alertId);
        if (el) {
            el.style.transition = "all 0.3s ease";
            el.style.opacity = "0";
            el.style.transform = "translateY(-10px)";
            setTimeout(function () {
                el.remove();
            }, 300);
        }
    }

    const successAlert = document.getElementById("successAlert");
    if (successAlert) {
        setTimeout(function () {
            dismissAlert("successAlert");
        }, 6000);
    }

</script>
