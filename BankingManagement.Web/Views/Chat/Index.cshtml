@{
    ViewData["Title"] = "AI Banking Assistant";
}

<div class="chat-page-wrapper">

    <!-- Page Header -->
    <div class="page-header">

        <a asp-controller="Home" asp-action="Index" class="back-button">
            <i class="bi bi-arrow-left"></i>
            Back to Dashboard
        </a>

        <div class="header-content">

            <div class="header-icon">
                <i class="bi bi-stars"></i>
            </div>

            <div>
                <h1>AI Banking Assistant</h1>
                <p>Ask natural questions about transactions, customer records, account metrics, and vault balances</p>
            </div>

        </div>

    </div>

    <!-- Quick Prompts Row -->
    <div class="quick-prompts-bar">
        <span class="quick-title"><i class="bi bi-lightbulb-fill"></i> Try Asking:</span>
        <button type="button" class="prompt-chip" onclick="askPreset('Which customer has most transactions')">
            🥇 Customer with most transactions
        </button>
        <button type="button" class="prompt-chip" onclick="askPreset('Total transactions in last month')">
            📊 Total transactions in last month
        </button>
        <button type="button" class="prompt-chip" onclick="askPreset('Customers with balance less than 1000')">
            📉 Customers with balance &lt; 1000
        </button>
        <button type="button" class="prompt-chip" onclick="askPreset('Total customers with active accounts')">
            👥 Total customers with active accounts
        </button>
        <button type="button" class="prompt-chip" onclick="askPreset('Total bank balance and liquidity')">
            💰 Bank balance & liquidity
        </button>
        <button type="button" class="prompt-chip" onclick="askPreset('Highest balance accounts')">
            🏆 Highest balance accounts
        </button>
    </div>

    <!-- Main Chat Container -->
    <div class="chat-main-card">

        <!-- Chat Header -->
        <div class="chat-card-header">
            <div class="bot-info">
                <div class="bot-avatar">
                    <i class="bi bi-robot"></i>
                </div>
                <div>
                    <strong>Banking Intelligence Bot</strong>
                    <span class="bot-status"><span class="status-dot"></span> Live DB Connected</span>
                </div>
            </div>
            <button type="button" class="clear-chat-btn" onclick="clearChat()">
                <i class="bi bi-trash3"></i>
                Clear Conversation
            </button>
        </div>

        <!-- Chat Messages Area -->
        <div class="chat-messages" id="chatMessages">

            <!-- Initial Greeting -->
            <div class="message-row bot-row">
                <div class="message-avatar bot-avatar-icon">
                    <i class="bi bi-stars"></i>
                </div>
                <div class="message-body">
                    <div class="message-bubble bot-bubble">
                        <p class="greeting-lead">👋 <strong>Hello! I am your AI Banking Assistant.</strong></p>
                        <p>I can query real-time database records and generate instant analytics for you. What would you like to know?</p>
                        <div class="bubble-suggestions">
                            <span class="suggestions-label">Popular queries:</span>
                            <button class="suggestion-pill" onclick="askPreset('Customers with balance less than 1000')">Customers with balance &lt; 1000</button>
                            <button class="suggestion-pill" onclick="askPreset('Total transactions in last month')">Total transactions in last month</button>
                            <button class="suggestion-pill" onclick="askPreset('Total customers with active accounts')">Customers with active accounts</button>
                            <button class="suggestion-pill" onclick="askPreset('Total bank balance')">Total bank balance</button>
                        </div>
                    </div>
                    <span class="message-time">Just now</span>
                </div>
            </div>

        </div>

        <!-- Chat Input Bar -->
        <div class="chat-input-bar">
            <form id="chatForm" onsubmit="handleChatSubmit(event)">
                <div class="input-wrapper">
                    <input type="text"
                           id="chatInput"
                           placeholder="Type a question (e.g. 'total transactions in last month' or 'customer Kishan')..."
                           autocomplete="off" />
                    <button type="submit" id="sendBtn" class="send-button">
                        <i class="bi bi-send-fill"></i>
                        <span>Send</span>
                    </button>
                </div>
            </form>
        </div>

    </div>

</div>

<style>

    body {
        background: #f5f7fb;
    }

    .chat-page-wrapper {
        max-width: 1050px;
        margin: 30px auto;
        padding: 0 20px 40px;
    }

    /* =========================
           HEADER
           ========================= */

    .page-header {
        margin-bottom: 20px;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #64748b;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 20px;
        transition: .2s;
    }

        .back-button:hover {
            color: #2563eb;
        }

    .header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 26px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        box-shadow: 0 8px 22px rgba(37, 99, 235, .25);
    }

    .header-content h1 {
        margin: 0;
        font-size: 27px;
        font-weight: 750;
        color: #1e293b;
    }

    .header-content p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    /* =========================
           PROMPTS BAR
           ========================= */

    .quick-prompts-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        overflow-x: auto;
        padding-bottom: 6px;
    }

    .quick-title {
        font-size: 12.5px;
        font-weight: 700;
        color: #64748b;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .quick-title i {
            color: #f59e0b;
        }

    .prompt-chip {
        border: 1px solid #dbe1ea;
        background: white;
        color: #334155;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
        transition: .2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }

        .prompt-chip:hover {
            border-color: #2563eb;
            color: #2563eb;
            background: #eef4ff;
            transform: translateY(-1px);
        }

    /* =========================
           CHAT MAIN CARD
           ========================= */

    .chat-main-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        box-shadow: 0 10px 35px rgba(15, 23, 42, .07);
        display: flex;
        flex-direction: column;
        height: 650px;
        overflow: hidden;
    }

    .chat-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 24px;
        border-bottom: 1px solid #eef2f7;
        background: #fafbfe;
    }

    .bot-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .bot-avatar {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .bot-info strong {
        display: block;
        font-size: 14px;
        color: #1e293b;
    }

    .bot-status {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        color: #059669;
        font-weight: 600;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
    }

    .clear-chat-btn {
        background: transparent;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: .2s;
    }

        .clear-chat-btn:hover {
            color: #dc2626;
            border-color: #fecaca;
            background: #fff5f5;
        }

    /* =========================
           MESSAGES
           ========================= */

    .chat-messages {
        flex: 1;
        padding: 24px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 20px;
        background: #fdfdfe;
    }

    .message-row {
        display: flex;
        gap: 12px;
        max-width: 82%;
    }

    .bot-row {
        align-self: flex-start;
    }

    .user-row {
        align-self: flex-end;
        flex-direction: row-reverse;
    }

    .message-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .bot-avatar-icon {
        background: #eef4ff;
        color: #2563eb;
    }

    .user-avatar-icon {
        background: #1e293b;
        color: white;
    }

    .message-body {
        display: flex;
        flex-direction: column;
    }

    .bot-row .message-body {
        align-items: flex-start;
    }

    .user-row .message-body {
        align-items: flex-end;
    }

    .message-bubble {
        padding: 14px 18px;
        border-radius: 16px;
        font-size: 13.5px;
        line-height: 1.6;
        word-break: break-word;
    }

    .bot-bubble {
        background: white;
        border: 1px solid #e2e8f0;
        color: #1e293b;
        border-top-left-radius: 4px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
    }

    .user-bubble {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: white;
        border-top-right-radius: 4px;
        box-shadow: 0 4px 15px rgba(37, 99, 235, 0.2);
    }

    .message-time {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 4px;
        padding: 0 4px;
    }

    .bubble-suggestions {
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px dashed #e2e8f0;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

    .suggestions-label {
        font-size: 11px;
        color: #94a3b8;
        font-weight: 600;
        width: 100%;
        margin-bottom: 2px;
    }

    .suggestion-pill {
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #2563eb;
        font-size: 11.5px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 14px;
        cursor: pointer;
        transition: .15s;
    }

        .suggestion-pill:hover {
            background: #2563eb;
            color: white;
            border-color: #2563eb;
        }

    /* Typing indicator */
    .typing-bubble {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 12px 18px;
    }

    .typing-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #94a3b8;
        animation: typingAnimation 1.4s infinite ease-in-out;
    }

        .typing-dot:nth-child(2) {
            animation-delay: 0.2s;
        }

        .typing-dot:nth-child(3) {
            animation-delay: 0.4s;
        }

    @@keyframes typingAnimation {
        0%, 60%, 100% {
            transform: translateY(0);
            opacity: 0.4;
        }
        30% {
            transform: translateY(-4px);
            opacity: 1;
        }
    }

    /* =========================
           INPUT BAR
           ========================= */

    .chat-input-bar {
        padding: 16px 20px;
        border-top: 1px solid #eef2f7;
        background: white;
    }

    .input-wrapper {
        display: flex;
        align-items: center;
        border: 1px solid #dbe1ea;
        border-radius: 13px;
        background: #fff;
        padding: 4px 6px 4px 16px;
        transition: .2s;
    }

        .input-wrapper:focus-within {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
        }

        .input-wrapper input {
            flex: 1;
            height: 44px;
            border: none;
            outline: none;
            font-size: 14px;
            color: #1e293b;
        }

    .send-button {
        height: 40px;
        padding: 0 18px;
        border-radius: 10px;
        border: none;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: white;
        font-size: 13.5px;
        font-weight: 650;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: .2s;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
    }

        .send-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.28);
        }

        .send-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

    /* =========================
           MOBILE
           ========================= */

    @@media (max-width: 768px) {
        .chat-page-wrapper {
            padding: 0 12px;
            margin-top: 15px;
        }

        .chat-main-card {
            height: 580px;
        }

        .message-row {
            max-width: 92%;
        }

        .send-button span {
            display: none;
        }

        .send-button {
            padding: 0 14px;
        }
    }

</style>

<script>

    const chatMessages = document.getElementById("chatMessages");
    const chatInput = document.getElementById("chatInput");
    const sendBtn = document.getElementById("sendBtn");

    function formatMarkdown(text) {
        if (!text) return "";
        let html = text
            .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
            .replace(/\*(.*?)\*/g, "<em>$1</em>")
            .replace(/\n\n/g, "<br/><br/>")
            .replace(/\n/g, "<br/>")
            .replace(/•\s+/g, "&bull; ");
        return html;
    }

    function scrollToBottom() {
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function appendUserMessage(text) {
        const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const div = document.createElement("div");
        div.className = "message-row user-row";
        div.innerHTML = `
            <div class="message-avatar user-avatar-icon">
                <i class="bi bi-person-fill"></i>
            </div>
            <div class="message-body">
                <div class="message-bubble user-bubble">
                    ${escapeHtml(text)}
                </div>
                <span class="message-time">${time}</span>
            </div>
        `;
        chatMessages.appendChild(div);
        scrollToBottom();
    }

    function appendBotTyping() {
        const div = document.createElement("div");
        div.id = "typingIndicator";
        div.className = "message-row bot-row";
        div.innerHTML = `
            <div class="message-avatar bot-avatar-icon">
                <i class="bi bi-stars"></i>
            </div>
            <div class="message-body">
                <div class="message-bubble bot-bubble typing-bubble">
                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>
                    <span class="typing-dot"></span>
                </div>
            </div>
        `;
        chatMessages.appendChild(div);
        scrollToBottom();
    }

    function removeBotTyping() {
        const typing = document.getElementById("typingIndicator");
        if (typing) typing.remove();
    }

    function appendBotMessage(reply, suggestions = []) {
        removeBotTyping();
        const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        let suggestionsHtml = "";
        if (suggestions && suggestions.length > 0) {
            suggestionsHtml = `
                <div class="bubble-suggestions">
                    <span class="suggestions-label">Suggestions:</span>
                    ${suggestions.map(s => `<button class="suggestion-pill" onclick="askPreset('${escapeJsString(s)}')">${escapeHtml(s)}</button>`).join('')}
                </div>
            `;
        }

        const div = document.createElement("div");
        div.className = "message-row bot-row";
        div.innerHTML = `
            <div class="message-avatar bot-avatar-icon">
                <i class="bi bi-stars"></i>
            </div>
            <div class="message-body">
                <div class="message-bubble bot-bubble">
                    <div>${formatMarkdown(reply)}</div>
                    ${suggestionsHtml}
                </div>
                <span class="message-time">${time}</span>
            </div>
        `;
        chatMessages.appendChild(div);
        scrollToBottom();
    }

    async function sendQuery(queryText) {
        if (!queryText || queryText.trim() === "") return;

        appendUserMessage(queryText);
        appendBotTyping();
        sendBtn.disabled = true;

        try {
            const res = await fetch("/Chat/Ask", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ message: queryText })
            });

            if (res.ok) {
                const data = await res.json();
                appendBotMessage(data.reply || "No reply received.", data.suggestions);
            } else {
                appendBotMessage("⚠️ Sorry, I could not process your query right now. Please try again.");
            }
        } catch (err) {
            appendBotMessage("⚠️ Network error while connecting to the assistant. Check if the backend is running.");
        } finally {
            sendBtn.disabled = false;
            chatInput.focus();
        }
    }

    function handleChatSubmit(e) {
        e.preventDefault();
        const text = chatInput.value.trim();
        if (text) {
            chatInput.value = "";
            sendQuery(text);
        }
    }

    function askPreset(promptText) {
        chatInput.value = "";
        sendQuery(promptText);
    }

    function clearChat() {
        chatMessages.innerHTML = `
            <div class="message-row bot-row">
                <div class="message-avatar bot-avatar-icon">
                    <i class="bi bi-stars"></i>
                </div>
                <div class="message-body">
                    <div class="message-bubble bot-bubble">
                        <p class="greeting-lead">👋 <strong>Conversation cleared.</strong></p>
                        <p>Ask any banking question or select one of the suggested prompts below.</p>
                        <div class="bubble-suggestions">
                            <span class="suggestions-label">Popular queries:</span>
                            <button class="suggestion-pill" onclick="askPreset('Total transactions in last month')">Total transactions in last month</button>
                            <button class="suggestion-pill" onclick="askPreset('Total customers with active accounts')">Customers with active accounts</button>
                            <button class="suggestion-pill" onclick="askPreset('Total bank balance')">Total bank balance</button>
                        </div>
                    </div>
                    <span class="message-time">Just now</span>
                </div>
            </div>
        `;
    }

    function escapeHtml(text) {
        return text
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }

    function escapeJsString(str) {
        return str.replace(/'/g, "\\'").replace(/"/g, '\\"');
    }

</script>
